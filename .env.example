# Vercel Postgres / Neon Database
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@ep-sample.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"

# Vercel KV (Redis)
KV_URL="redis://default:sample@sample.kv.vercel-storage.com:36423"
KV_REST_API_URL="https://sample.kv.vercel-storage.com"
KV_REST_API_TOKEN="sample_token"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# NextAuth v5
AUTH_SECRET="dev-secret-key-change-in-production-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
AUTH_GOOGLE_ID="google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="google-client-secret"
AUTH_GITHUB_ID="github-client-id"
AUTH_GITHUB_SECRET="github-client-secret"
