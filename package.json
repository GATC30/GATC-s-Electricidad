{
  "name": "gatc",
  "version": "2.0.0",
  "private": true,
  "description": "GATC - Gestor de Análisis para Tendidos y Costos",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2",
    "immer": "^10.1.1",
    "three": "^0.165.0",
    "@react-three/fiber": "^8.16.8",
    "@react-three/drei": "^9.106.0",
    "jspdf": "^2.5.1",
    "@vercel/postgres": "^0.8.0",
    "@vercel/kv": "^1.0.1",
    "@vercel/blob": "^0.23.3",
    "@prisma/client": "^5.15.0",
    "next-auth": "^5.0.0-beta.19"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "typescript": "^5.4.5",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "prisma": "^5.15.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.4",
    "@typescript-eslint/parser": "^7.13.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "prettier": "^3.3.2",
    "lint-staged": "^15.2.7",
    "husky": "^9.0.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
